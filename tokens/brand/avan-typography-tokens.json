{
  "$description": "AVAN GROUP \u00b7 A2.2 Typography System \u00b7 Global + Semantic + Component tiers (W3C DTCG)",
  "font": {
    "family": {
      "display": {
        "$value": "'Cormorant Garamond', Georgia, 'Times New Roman', serif",
        "$type": "fontFamily"
      },
      "text": {
        "$value": "\"Suisse Int'l\", 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
        "$type": "fontFamily",
        "$description": "Fixed 2026-06-24 audit: source previously read 'Suisse Int'l' (single-quoted), which is invalid CSS — the embedded apostrophe closes the string early. Now double-quoted per CSS font-family syntax for names containing an apostrophe."
      },
      "mono": {
        "$value": "\"Suisse Int'l Mono\", 'IBM Plex Mono', ui-monospace, 'SF Mono', Menlo, monospace",
        "$type": "fontFamily",
        "$description": "Fixed 2026-06-24 audit: same single-quote escaping issue as font.family.text."
      }
    },

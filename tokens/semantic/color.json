  "theme": {
    "light": {
      "$description": "Default scope: cream field (A2.1 semantic.light).",
      "surface-canvas": {
        "$type": "color",
        "$value": "{semantic.light.surface-base}"
      },
      "surface-raised": {
        "$type": "color",
        "$value": "{semantic.light.surface-raised}"
      },
      "surface-overlay": {
        "$type": "color",
        "$value": "{color.base.white}"
      },
      "fg": {
        "$type": "color",

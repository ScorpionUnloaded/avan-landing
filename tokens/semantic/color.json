      },
      "action-bg": {
        "$type": "color",
        "$value": "{semantic.light.action-primary-bg}"
      },
      "action-bg-hover": {
        "$type": "color",
        "$value": "{color.ink.800}"
      },
      "action-fg": {
        "$type": "color",
        "$value": "{color.base.cream}"
      },
      "focus-ring": {
        "$type": "color",
        "$value": "{color.bronze.600}",
        "$description": "State tokens name alias.brand-secondary (bronze.500, 2.9:1 on cream). Focus indicators need 3:1, so bronze.600 on light surfaces; bronze.400 on dark ones."
      },
      "state-success": {
        "$type": "color",
        "$value": "{semantic.light.state-success}"
      },
      "state-warning": {
        "$type": "color",
        "$value": "{semantic.light.state-warning}"
      },
      "state-error": {
        "$type": "color",
        "$value": "{semantic.light.state-error}"
      },
      "state-info": {
        "$type": "color",
        "$value": "{semantic.light.state-info}"
      },

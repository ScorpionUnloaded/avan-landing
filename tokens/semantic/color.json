      },
      "fg-muted": {
        "$type": "color",
        "$value": "{semantic.light.text-secondary}"
      },
      "fg-eyebrow": {
        "$type": "color",
        "$value": "{color.bronze.700}",
        "$description": "Brand names bronze.600 (4.23:1 on cream, AA-large only). Eyebrows are 12px, so bronze.700 (6.9:1) — A2.1: 'any cell below AA fails the build'."
      },
      "fg-gilt": {
        "$type": "color",
        "$value": "{color.bronze.600}",
        "$description": "Gilt text at display sizes only (≥ 24px): bronze.600 is 4.2:1 on cream — passes the 3:1 large-text threshold, not body text."
      },
      "border-hairline": {
        "$type": "color",
        "$value": "{semantic.light.border-hairline}"
      },
      "border-strong": {
        "$type": "color",
        "$value": "{color.bronze.600}",
        "$description": "Field and control boundaries: ≥ 3:1 against the surface (WCAG 1.4.11)."
      },
      "accent": {
        "$type": "color",
        "$value": "{semantic.light.action-accent}"
      },
      "gilt": {
        "$type": "color",

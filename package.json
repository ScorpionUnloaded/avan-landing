    "test:e2e": "playwright test",
    "lhci": "lhci autorun",
    "prebuild": "npm run tokens:check"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "motion": "13.4.4",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/culori": "4.0.1",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "culori": "4.0.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "lighthouse": "13.5.0",
    "postcss": "8.5.28",
    "style-dictionary": "5.5.5",

{
  "name": "avan-landing",
  "version": "1.0.0",
  "private": true,
  "description": "AVAN Group — the house's public site. Next.js 16, brand tokens (DTCG), EN/FR.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",

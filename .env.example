# --- Site ---
# Canonical production URL (metadata, OG image, sitemap, robots). No trailing slash.
NEXT_PUBLIC_SITE_URL=

# --- Inquiry delivery (all optional; graceful no-op in dev when unset) ---
# Primary channel: Resend (https://resend.com). Both values required to activate.
# When active, the house is notified AND the inquirer receives a quiet acknowledgment.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=
# Sender identity; must be a verified domain in Resend. Falls back to onboarding@resend.dev.
INQUIRY_FROM_EMAIL=

# Fallback channel: forwarded as JSON if Resend is unset or fails (CRM/Zapier/Slack).
INQUIRY_WEBHOOK_URL=

# Behavior: if any channel is configured and ALL fail, the API returns 502 and the
# form shows "Something interrupted us. Try once more." — inquiries are never lost silently.

# --- Deployment (set by Vercel; listed so their effect is documented) ---
# VERCEL_ENV=preview|development → pages answer noindex and robots.txt disallows all.
# VERCEL=1 → Vercel Web Analytics and Speed Insights are rendered (cookieless).
